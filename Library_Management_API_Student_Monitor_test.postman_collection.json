{
  "info": {
    "_postman_id": "412b367f-d848-4c74-8e0e-9be52c3a662a",
    "name": "Library Management API – Student - Monitor test",
    "description": "Bộ API dành cho học sinh ôn luyện. Không bao gồm Admin và System endpoints.\n\n**Tài khoản mẫu:**\n- admin@library.local / password (role: admin)\n- librarian1@library.local / password (role: librarian)\n- librarian2@library.local / password (role: librarian)\n\n⚠️ Database tự reset mỗi ngày lúc 02:00 AM.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "43977979"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data) {",
                  "    pm.collectionVariables.set('access_token', res.data.access_token);",
                  "    pm.collectionVariables.set('refresh_token', res.data.refresh_token);",
                  "    console.log('✅ Tokens saved to collection variables.');",
                  "}",
                  "",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time is acceptable\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test(\"Response body is valid JSON object\", function () {",
                  "    pm.expect(res).to.be.an(\"object\");",
                  "});",
                  "",
                  "pm.test(\"success is true\", function () {",
                  "    pm.expect(res.success).to.eql(true);",
                  "});",
                  "",
                  "pm.test(\"statusCode is 200\", function () {",
                  "    pm.expect(res.statusCode).to.eql(200);",
                  "});",
                  "",
                  "pm.test(\"message is correct\", function () {",
                  "    pm.expect(res.message).to.eql(\"Login successful.\");",
                  "});",
                  "",
                  "pm.test(\"data object exists\", function () {",
                  "    pm.expect(res.data).to.be.an(\"object\");",
                  "});",
                  "",
                  "pm.test(\"user object exists\", function () {",
                  "    pm.expect(res.data.user).to.be.an(\"object\");",
                  "});",
                  "",
                  "pm.test(\"user.id is valid\", function () {",
                  "    pm.expect(res.data.user.id).to.be.a(\"number\");",
                  "    pm.expect(res.data.user.id).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"username is admin\", function () {",
                  "    pm.expect(res.data.user.username).to.eql(\"admin\");",
                  "});",
                  "",
                  "pm.test(\"email is correct\", function () {",
                  "    pm.expect(res.data.user.email).to.eql(\"admin@library.local\");",
                  "});",
                  "",
                  "pm.test(\"role is admin\", function () {",
                  "    pm.expect(res.data.user.role).to.eql(\"admin\");",
                  "});",
                  "",
                  "pm.test(\"refresh_token field exists in user\", function () {",
                  "    pm.expect(res.data.user.refresh_token).to.be.a(\"string\");",
                  "    pm.expect(res.data.user.refresh_token).to.not.be.empty;",
                  "});",
                  "",
                  "pm.test(\"token_invalidated_at is null\", function () {",
                  "    pm.expect(res.data.user.token_invalidated_at).to.eql(null);",
                  "});",
                  "",
                  "pm.test(\"created_at exists\", function () {",
                  "    pm.expect(res.data.user.created_at).to.be.a(\"string\");",
                  "    pm.expect(res.data.user.created_at).to.not.be.empty;",
                  "});",
                  "",
                  "pm.test(\"updated_at exists\", function () {",
                  "    pm.expect(res.data.user.updated_at).to.be.a(\"string\");",
                  "    pm.expect(res.data.user.updated_at).to.not.be.empty;",
                  "});",
                  "",
                  "pm.test(\"access_token exists\", function () {",
                  "    pm.expect(res.data.access_token).to.be.a(\"string\");",
                  "    pm.expect(res.data.access_token).to.not.be.empty;",
                  "});",
                  "",
                  "pm.test(\"refresh_token exists\", function () {",
                  "    pm.expect(res.data.refresh_token).to.be.a(\"string\");",
                  "    pm.expect(res.data.refresh_token).to.not.be.empty;",
                  "});",
                  "",
                  "pm.test(\"token_type is Bearer\", function () {",
                  "    pm.expect(res.data.token_type).to.eql(\"Bearer\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@library.local\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Đăng nhập và nhận access_token + refresh_token.\n\nSau khi chạy thành công, access_token và refresh_token sẽ được tự động lưu vào collection variables."
          },
          "response": []
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Xem thông tin tài khoản đang đăng nhập."
          },
          "response": []
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          ""
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://yourdomain.com/api"
    },
    {
